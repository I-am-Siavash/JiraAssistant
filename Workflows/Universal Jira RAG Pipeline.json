    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n    let comments = [];\n    let attachments = [];\n\n    for (const key in item.json) {\n        if (key.startsWith('Comment') && item.json[key]) {\n            comments.push(item.json[key]);\n        }\n        if (key.startsWith('Attachment') && item.json[key]) {\n            attachments.push(item.json[key]);\n        }\n    }\n\n    results.push({\n        json: {\n            Summary: item.json.Summary || '',\n            IssueId: item.json['Issue id'] || '',\n            IssueType: item.json['Issue Type'] || '',\n            Status: item.json.Status || '',\n            Description: item.json.Description || '',\n            Resolution: item.json.Resolution || '',\n            Comments: comments,\n            Attachments: attachments\n        }\n    });\n}\n\nreturn results;"
      },
