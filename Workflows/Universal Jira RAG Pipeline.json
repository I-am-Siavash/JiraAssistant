    {
      "parameters": {
        "jsCode": "const mainItem = $items(\"Has Attachments?\")[0].json;\n\nconst attachmentItems = $input.all().flatMap(item => {\n    const value = item.json?.data;\n\n    if (Array.isArray(value)) {\n        return value;\n    }\n\n    return [item.json];\n});\n\nconst attachments = attachmentItems\n    .map((a, index) => {\n        const type = a.type || 'Unknown';\n        const source = a.source || '';\n\n        let extractor = 'unknown';\n\n        if (/ocr/i.test(type)) {\n            extractor = 'glm-ocr';\n        } else if (/pdf/i.test(type)) {\n            extractor = 'pdf-parser';\n        } else if (/text|code/i.test(type)) {\n            extractor = 'native-text';\n        } else if (/spreadsheet|excel|xls/i.test(type)) {\n            extractor = 'spreadsheet-parser';\n        }\n\n        const content = a.content || '';\n\n        return {\n            attachment_id: index + 1,\n\n\n            source,\n\n            type,\n\n            mime_type: a.mime_type || '',\n\n            extractor,\n\n            content,\n\n        };\n    })\n    .filter(a => a.content.trim() !== '');\n\n\nmainItem.Unified_Attachment_Context = attachments;\n\n\nreturn [{\n    json: mainItem\n}];"
      },
      "type": "n8n-nodes-base.code",
