    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"model\": \"glm-ocr\",\n    \"keep_alive\": 3600,\n    \"messages\": [{\n        \"role\": \"user\",\n        \"content\": \"Text Recognition: Extract all visible text from this image. Preserve error messages, exception names, stack traces, class names, method names, file names and line numbers. Return only the extracted text.\",\n        \"images\": [\"{{ $json.data }}\"]\n    }],\n    \"stream\": false\n}",
        "options": {
          "timeout": 10000000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "id": "6d6a153f-9697-466a-a75f-872fa78cf838",
      "name": "Ollama glm-ocr"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => ({\n    json: {\n        source: item.json.fileName || '',\n        type: 'Image (OCR)',\n        mime_type: item.json.mimeType,\n        content: item.json.message?.content || ''\n    }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        16
      ],
